# Database
# Dashboard DB URL (Turso Cloud for production, local file for development)
DASHBOARD_DB_URL="libsql://stores4u-dashboard-xxx.aws-ap-south-1.turso.io"
# Local path for dashboard DB (used in development)
DASHBOARD_DB_PATH="databases/dashboard.db"
# Auth token for Turso dashboard DB
DASHBOARD_DB_TOKEN=""

# Origin URL for the dashboard app
ORIGIN=""

# Turso Cloud (for managing per-shop databases)
TURSO_API_TOKEN=""
TURSO_GROUP_AUTH_TOKEN=""
TURSO_GROUP="stores4u"
TURSO_ORGANIZATION=""
TURSO_PARENT_DB_NAME="stores4u-parent"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenTelemetry
OTEL_ENABLED="true"
OTEL_SERVICE_NAME="dashboard"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Logging
LOG_LEVEL="info"
