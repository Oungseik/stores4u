{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "types": ["bun"],
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/server/**/*.ts", "src/client/**/*.ts"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
