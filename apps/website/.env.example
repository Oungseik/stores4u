# Database
# Turso URL for auth DB (production) or local file path (development)
AUTH_DATABASE_URL="databases/auth.db"
# Local path for auth DB file
AUTH_DB_PATH="databases/auth.db"
# Auth token for Turso auth DB
AUTH_DB_TOKEN=""

# Turso auth token (for auth DB connection)
TURSO_GROUP_AUTH_TOKEN=""

# Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Public (exposed to client-side)
PUBLIC_SITE_NAME="Kagom"
PUBLIC_DOMAIN="http://localhost:5173"
PUBLIC_ENVIRONMENT="development"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Email (SES SMTP)
NO_REPLY_EMAIL="noreply@example.com"
SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SES_SMTP_PORT="465"
SES_SMTP_USER=""
SES_SMTP_PASS=""

# Storage (S3/R2 compatible)
STORAGE_PUBLIC_URL="https://your-storage-url.com"
STORAGE_BUCKET_NAME=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI
OPENROUTER_API_KEY=""
REPLICATE_API_TOKEN=""

# Shops
# Directory for per-shop databases
SHOPS_DB_DIR="databases/shops"
# Parent database URL (local template for new shops)
PARENT_DATABASE_URL="databases/shops/parent.db"

# Observability
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_NAME="stores4u"
