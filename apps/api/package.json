{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "dev": "bun --bun run with-env bun --watch src/index.ts",
    "start": "bun --bun run with-env bun src/index.ts",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/vitest": "4.0.0-beta.93",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0",
    "effect": "^4.0.0-beta.93"
  }
}
