{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/db",
  "type": "module",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "check": "biome check --write .",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "db:push": "bun --bun run with-env drizzle-kit push",
    "db:studio": "bun --bun run with-env drizzle-kit studio",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun run with-env drizzle-kit migrate",
    "db:seed": "bunx dotenv -e ../../.env -- bun run seed.ts",
    "db:seed:shop": "SHOP_SLUG=binary-stride bunx dotenv -e ../../.env -- bun run seed.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@tursodatabase/api": "^2.0.0",
    "@tursodatabase/database": "^0.5.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.20",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.20",
    "drizzle-seed": "^0.3.1",
    "tsdown": "0.21.10",
    "typescript": "^6.0.3"
  }
}
