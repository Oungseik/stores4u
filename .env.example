# Turso — development setup replaces these values; production setup uses its own copy.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN=""

# Better Auth — development setup generates the secret; set the final HTTPS URL for production.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Public app settings.
PUBLIC_SITE_NAME="stores4u"
PUBLIC_ENVIRONMENT="development"

# Optional social OAuth. Leave blank to disable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional purchase-invoice OCR.
MISTRAL_API_KEY=""
