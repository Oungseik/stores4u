# vim:set filetype=sh :

# PUBLIC_ENVIRONMENT is used to control features based on environment.
# When set to "development": uses local SQLite databases (no internet required)
# When not set or "production": uses Turso Cloud databases
PUBLIC_ENVIRONMENT=development

# BETTER_AUTH_SECRET is used by Better Auth for signing JWTs and securing sessions.
# It should be a long, random string.
BETTER_AUTH_SECRET=xxx

# BETTER_AUTH_URL is the base URL for Better Auth (used for callbacks)
BETTER_AUTH_URL=http://localhost:5173

# =============================================================================
# Turso Cloud Configuration
# Get these from https://app.turso.tech
# These are REQUIRED for production, OPTIONAL for development
# =============================================================================

# API token for Turso management API (turso auth api-tokens create <token-name>)
TURSO_API_TOKEN=xxx

# Group token for database connections (turso group tokens create <group-name>)
TURSO_GROUP_AUTH_TOKEN=xxx

# Group name for the collection of databases
TURSO_GROUP=xxx

# Your personal or organization name
TURSO_ORGANIZATION=xxx

# Parent database name (the schema database used to create per-shop databases)
# This database should have the shop schema already applied
TURSO_PARENT_DB_NAME=pos-parent

# =============================================================================
# Database URLs
# Development: Use local file paths (e.g., /path/to/databases/auth.db)
# Production: Use Turso Cloud URLs (e.g., libsql://pos-auth-org.turso.io)
# =============================================================================

# Auth database URL
AUTH_DATABASE_URL=/path/to/databases/auth.db

# Parent database URL (for local development, this is the template for new shops)
PARENT_DATABASE_URL=/path/to/databases/parent.db

# Directory for shop databases (local development only)
SHOP_DATA_DIR=/path/to/databases

# Path to migration folder for database migrations
MIGRATION_FOLDER=/path/to/packages/db/migrations

# =============================================================================
# Google OAuth Configuration
# =============================================================================
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# =============================================================================
# Email Configuration (AWS SES SMTP)
# SES sender identity must be verified in the same region as these credentials.
# =============================================================================
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=465
SES_SMTP_USER=AKIAxxxxxxxxxxxxxxxx
SES_SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NO_REPLY_EMAIL=noreply@example.com

# Site name displayed across the website
PUBLIC_SITE_NAME=Kagom

# =============================================================================
# Storage Configuration (S3/R2 compatible)
# =============================================================================
STORAGE_PUBLIC_URL=https://your-storage-url.com
STORAGE_BUCKET_NAME=xxx
STORAGE_ENDPOINT=https://your-endpoint.com
STORAGE_ACCESS_KEY_ID=xxx
STORAGE_SECRET_ACCESS_KEY=xxx
AWS_SESSION_TOKEN=
S3_SESSION_TOKEN=

# =============================================================================
# OpenTelemetry Configuration
# =============================================================================

# Enable/disable OpenTelemetry tracing (default: true)
OTEL_ENABLED=true

# Service name for traces
OTEL_SERVICE_NAME=website

# OTLP endpoint for trace export (e.g., Jaeger, Grafana Tempo, SigNoz)
# For local Jaeger: http://localhost:4317
# For Grafana Tempo: http://tempo:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info


# =============================================================================
# Serverless GPU for OCR
# =============================================================================

REPLICATE_API_TOKEN=xxx

# =============================================================================
# OpenRouter Configuration (for AI invoice processing)
# =============================================================================

OPENROUTER_API_KEY=xxx
