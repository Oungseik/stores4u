{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --host",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome lint --write . && eslint . --fix",
    "format": "prettier --write . && biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run format",
    "test:unit": "vitest",
    "test": "bun --bun run test:unit -- --run"
  },
  "devDependencies": {
