{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --host",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
    "lint": "biome lint --write . && eslint \"src/**/*.svelte\" --fix --cache",
    "format": "prettier --write . && biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run format",
    "test": "bun --bun vitest --run"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.19.2",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "svelte-meta-tags": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.1",
    "@internationalized/date": "^3.12.4",
    "@libsql/client": "^0.17.4",
    "@lucide/svelte": "^1.44.0",
    "@mistralai/mistralai": "^2.7.0",
    "@orpc/client": "2.0.0-beta.35",
    "@orpc/server": "2.0.0-beta.35",
    "@orpc/tanstack-query": "2.0.0-beta.35",
    "@repo/config": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-form": "^1.33.5",
    "@tanstack/svelte-query": "^6.1.48",
    "@types/d3-shape": "^3.2.0",
    "ai": "^7.0.97",
    "better-auth": "^1.7.4",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.15",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "layerchart": "2.0.1",
    "libphonenumber-js": "^1.13.13",
    "lru-cache": "^11.5.2",
    "maska": "^3.2.1",
    "mode-watcher": "^1.1.0",
    "rate-limiter-flexible": "^11.2.0",
    "runed": "^0.37.1",
    "svelte-sonner": "^1.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  }
}
