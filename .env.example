# vim:set filetype=sh :

# PUBLIC_ENVIRONMENT is used to control features based on environment.
# When set to "development": uses local SQLite databases (no internet required)
# When not set or "production": uses Turso Cloud databases
PUBLIC_ENVIRONMENT=development

# apps/api HTTP port
PORT=5000

# BETTER_AUTH_SECRET is used by Better Auth for signing JWTs and securing sessions.
# It should be a long, random string.
BETTER_AUTH_SECRET=xxx

# BETTER_AUTH_URL is the base URL for Better Auth (used for callbacks)
BETTER_AUTH_URL=http://localhost:5173

# =============================================================================
# Turso Cloud Configuration
# Get these from https://app.turso.tech
# These are REQUIRED for production, OPTIONAL for development
# =============================================================================

# API token for Turso management API (turso auth api-tokens create <token-name>)
TURSO_API_TOKEN=xxx

# Group token for database connections (turso group tokens create <group-name>)
TURSO_GROUP_AUTH_TOKEN=xxx

# Group name for the collection of databases
TURSO_GROUP=xxx

# Your personal or organization name
TURSO_ORGANIZATION=xxx

# Parent database name (the schema database used to create per-shop databases)
# This database should have the shop schema already applied
TURSO_PARENT_DB_NAME=pos-parent

# =============================================================================
# Database Configuration
# Development: Use local file paths (e.g., databases/auth.db)
# Production: Use Turso Cloud URLs (e.g., libsql://pos-auth-org.turso.io)
# =============================================================================

# Auth database URL
AUTH_DATABASE_URL=databases/auth.db

# Local path for auth DB file (used in development)
AUTH_DB_PATH=databases/auth.db

# Auth token for Turso auth DB (required in production)
AUTH_DB_TOKEN=

# Dashboard database URL
DASHBOARD_DB_URL=libsql://stores4u-dashboard-xxx.aws-ap-south-1.turso.io

# Local path for dashboard DB file (used in development)
DASHBOARD_DB_PATH=databases/dashboard.db

# Auth token for Turso dashboard DB (required in production)
DASHBOARD_DB_TOKEN=

# Parent database URL (local template for new shops)
PARENT_DATABASE_URL=data/shops/parent.db

# Directory for per-shop databases
SHOPS_DB_DIR=databases/shops

# =============================================================================
# Google OAuth Configuration
# =============================================================================
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# =============================================================================
# Facebook OAuth Configuration
# =============================================================================
FACEBOOK_CLIENT_ID=xxx
FACEBOOK_CLIENT_SECRET=xxx

# =============================================================================
# Email Configuration (generic SMTP)
# Optional: leave unset for offline / local dev (email flows fall back to
# copyable links). When set, better-auth sends verify / reset / magic-link /
# 2FA-OTP emails through this transport.
# =============================================================================
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=AKIAxxxxxxxxxxxxxxxx
SMTP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Store <noreply@example.com>"

# Site name displayed across the website
PUBLIC_SITE_NAME=Kagom

# Public domain URL (used for callbacks and links)
PUBLIC_DOMAIN=http://localhost:5173

# =============================================================================
# Storage Configuration (S3/R2 compatible)
# =============================================================================
STORAGE_PUBLIC_URL=https://your-storage-url.com
STORAGE_BUCKET_NAME=xxx
STORAGE_ENDPOINT=https://your-endpoint.com
STORAGE_ACCESS_KEY_ID=xxx
STORAGE_SECRET_ACCESS_KEY=xxx

# =============================================================================
# Serverless GPU for OCR
# =============================================================================

REPLICATE_API_TOKEN=xxx

# =============================================================================
# OpenRouter Configuration (for AI invoice processing)
# =============================================================================

OPENROUTER_API_KEY=xxx

# =============================================================================
# Observability
# =============================================================================

# Application log level (debug, info, warn, error)
LOG_LEVEL=info

# OpenTelemetry exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OpenTelemetry headers (optional, for authenticated exporters)
# OTEL_EXPORTER_OTLP_HEADERS=

# OpenTelemetry service name
OTEL_SERVICE_NAME=stores4u
