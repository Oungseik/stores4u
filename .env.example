# Turso — used by the website at runtime and by deploy-time migrations.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN=""

# Better Auth — set the final HTTPS URL before copying this file to .env.prod.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Public app settings.
PUBLIC_SITE_NAME="Kagom"
PUBLIC_ENVIRONMENT="development"

# Optional social OAuth. Leave blank to disable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional purchase-invoice OCR.
MISTRAL_API_KEY=""
