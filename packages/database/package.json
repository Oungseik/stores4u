{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/database",
  "description": "Single-store Drizzle schema, Turso client factory, and Drizzle Kit config",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "build": "tsdown --no-dts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run format",
    "test": "bun --bun vitest --run",
    "db:generate": "bun --bun run with-env drizzle-kit generate",
    "db:migrate": "bun --bun run with-env drizzle-kit migrate",
    "db:studio": "bun --bun run with-env drizzle-kit studio"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@repo/config": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "0.22.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
