# ──────────────────────────────────────────────────────────────────────────
# REQUIRED — set these before first run (the /setup wizard needs them).
# One store per server, single SQLite database (auth + store data).
# ──────────────────────────────────────────────────────────────────────────

# Database — path to the single SQLite file. Created on first run.
DATABASE_PATH="databases/store.db"

# Better Auth — secret (32+ chars, high entropy) and the public online origin.
# In development (PUBLIC_ENVIRONMENT=development) baseURL is derived from the
# request, so BETTER_AUTH_URL only matters in production.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Public — exposed to the client. environment: "development" | "production".
PUBLIC_SITE_NAME="Kagom"
PUBLIC_ENVIRONMENT="development"

# Bun production server / private Caddy proxy. The deploy installers set these.
# Keep BETTER_AUTH_URL and ORIGIN equal to the stable trusted LAN HTTPS URL.
ORIGIN="http://localhost:5173"
HOST="127.0.0.1"
PORT="3000"
BODY_SIZE_LIMIT="12M"
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"

# File storage — two backends, pick one per deployment. No URL migration on switch.
#   STORAGE_DRIVER="local"  → writes to STORAGE_LOCAL_DIR, served by /storage/* (offline-capable)
#   anything else / unset   → S3/R2 via Bun's S3Client (needs the S3 block below)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="databases/storage"
# S3/R2 (required only when STORAGE_DRIVER is not "local")
STORAGE_PUBLIC_URL="https://your-storage-url.com"
STORAGE_BUCKET_NAME=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL — each block can stay empty; the app runs without it.
# ──────────────────────────────────────────────────────────────────────────

# Social OAuth — only if you want social sign-in. During first run only, a
# social login may create the first owner; afterwards OAuth only signs into
# already-linked accounts. Leave blank to disable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Email (SMTP) — generic, optional. All auth flows (verify / reset / magic-link)
# also render a copyable link pair as fallback, so email never blocks the user.
# Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Purchase-invoice OCR — structured extraction via Mistral. Required only if
# you use the purchase-invoice scan feature.
MISTRAL_API_KEY=""

# Logging & observability — all optional with sensible defaults.
LOG_LEVEL="info"
OTEL_ENABLED="true"                       # set "false" to disable tracing entirely
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="stores4u"
