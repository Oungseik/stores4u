# Drizzle
# Replace with your DB credentials!
DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# Shop Databases (local-first sync with Turso)
# Directory for local shop database files
SHOPS_DB_DIR="./data/shops"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenTelemetry
OTEL_ENABLED="true"
OTEL_SERVICE_NAME="dashboard"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Logging
LOG_LEVEL="info"
