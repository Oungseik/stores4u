# Database
# Single SQLite database (auth + store data) — one store per server
DATABASE_PATH="databases/store.db"

# Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Public (exposed to client-side)
PUBLIC_SITE_NAME="Kagom"
PUBLIC_DOMAIN="http://localhost:5173"
PUBLIC_ENVIRONMENT="development"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Storage
# STORAGE_DRIVER: "local" writes to STORAGE_LOCAL_DIR and serves via /storage/* (offline-capable);
# omit (or any other value) to use S3/R2 below.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="databases/storage"
# S3/R2 (required when STORAGE_DRIVER is not "local")
STORAGE_PUBLIC_URL="https://your-storage-url.com"
STORAGE_BUCKET_NAME=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI
OPENROUTER_API_KEY=""
REPLICATE_API_TOKEN=""

# Observability
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_NAME="stores4u"
