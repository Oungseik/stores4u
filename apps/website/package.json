{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --host",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "cf-types": "wrangler types --include-runtime=false",
    "cf-types:check": "wrangler types --include-runtime=false --check",
    "typecheck": "bun run cf-types:check && svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
    "lint": "biome lint --write . && eslint \"src/**/*.svelte\" --fix --cache",
    "format": "prettier --write . && biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run format",
    "test": "bun --bun vitest --run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.1",
    "bits-ui": "^2.18.0",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.7",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "svelte-meta-tags": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.38.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.22.0",
    "@internationalized/date": "^3.12.2",
    "@libsql/client": "^0.17.4",
    "@lucide/svelte": "^1.25.0",
    "@mistralai/mistralai": "^2.5.0",
    "@orpc/client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@orpc/tanstack-query": "^1.14.8",
    "@repo/config": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-form": "^1.33.2",
    "@tanstack/svelte-query": "^6.1.36",
    "@types/d3-shape": "^3.1.8",
    "ai": "^7.0.31",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.12",
    "html5-qrcode": "^2.3.8",
    "layerchart": "2.0.1",
    "libphonenumber-js": "^1.13.9",
    "lru-cache": "^11.5.2",
    "maska": "^3.2.0",
    "mode-watcher": "^1.1.0",
    "rate-limiter-flexible": "^11.2.0",
    "runed": "^0.37.1",
    "svelte-sonner": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  }
}
