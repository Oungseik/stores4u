# vim:set filetype=sh :

# PUBLIC_ENVIRONMENT is used to control features based on environment.
# For example when `"development"`, every oRPC procedure will be in separate request to be easier to debug,
# but if it is not set, the procedures will be batch for better performance
PUBLIC_ENVIRONMENT=development

# BETTER_AUTH_SECRET is used by Better Auth for signing JWTs and securing sessions.
# It should be a long, random string.
BETTER_AUTH_SECRET=xxx

# BETTER_AUTH_URL is the base URL for Better Auth (used for callbacks)
BETTER_AUTH_URL=http://localhost:5173

# Turso Configuration
# Get these from https://app.turso.tech

# API token for Turso management API (turso auth api-tokens create <token-name>)
TURSO_API_TOKEN=xxx

# Group token for database connections (turso group tokens create <group-name>)
TURSO_GROUP_AUTH_TOKEN=xxx

# Group name for the collection of databases
TURSO_GROUP=xxx

# Your personal or organization name
TURSO_ORGANIZATION=xxx

# Auth database URL (auto-generated from TURSO_ORGANIZATION)
# Format: libsql://auth-{TURSO_ORGANIZATION}.aws-ap-northeast-1.turso.io
# Or for local development: /path/to/databases/auth.db
AUTH_DATABASE_URL=libsql://auth-{TURSO_ORGANIZATION}.aws-ap-northeast-1.turso.io

# Parent database URL (auto-generated from TURSO_ORGANIZATION)
# Format: libsql://parent-{TURSO_ORGANIZATION}.aws-ap-northeast-1.turso.io
# Or for local development: /path/to/databases/parent.db
PARENT_DATABASE_URL=libsql://parent-{TURSO_ORGANIZATION}.aws-ap-northeast-1.turso.io

# Parent database name (the schema database used to create per-shop databases)
TURSO_PARENT_DB_NAME=parent-myorg

# Directory for shop databases (local development)
SHOP_DATA_DIR=/path/to/databases

# Path to migration folder for database migrations
MIGRATION_FOLDER=/path/to/packages/db/migrations

# Google OAuth Configuration
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# Site name displayed across the website
PUBLIC_SITE_NAME=Kagom

# Storage Configuration (S3/R2 compatible)
STORAGE_PUBLIC_URL=https://your-storage-url.com
STORAGE_BUCKET_NAME=xxx
STORAGE_ENDPOINT=https://your-endpoint.com
STORAGE_ACCESS_KEY_ID=xxx
STORAGE_SECRET_ACCESS_KEY=xxx
AWS_SESSION_TOKEN=
S3_SESSION_TOKEN=
