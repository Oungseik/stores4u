{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --host",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write . && biome format --write .",
    "lint": "biome lint .",
    "lint:eslint": "prettier --check . && eslint .",
    "test:unit": "bunx --bun vitest",
    "test": "npm run test:unit -- --run",
    "with-env": "dotenv -e ../../.env --",
    "db:push": "bun --bun run with-env drizzle-kit push",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun run with-env drizzle-kit migrate",
    "db:studio": "bun --bun run with-env drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/table-core": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "bits-ui": "^2.18.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.20",
    "drizzle-orm": "1.0.0-beta.20",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.7",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.55.5",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.6",
    "svelte-meta-tags": "^4.6.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@ai-sdk/svelte": "^4.0.172",
    "@inlang/paraglide-js": "^2.18.0",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@mastra/ai-sdk": "^1.4.1",
    "@mastra/core": "^1.30.0",
    "@mastra/libsql": "^1.9.0",
    "@mastra/memory": "^1.17.4",
    "@openrouter/sdk": "^0.12.24",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.74.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.216.0",
    "@opentelemetry/instrumentation-pino": "^0.62.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@orpc/client": "^1.14.0",
    "@orpc/otel": "^1.14.0",
    "@orpc/server": "^1.14.0",
    "@orpc/tanstack-query": "^1.14.0",
    "@repo/config": "workspace:*",
    "@repo/perstore-db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-form": "^1.29.1",
    "@tanstack/svelte-query": "^6.1.25",
    "@tursodatabase/api": "^2.0.0",
    "@tursodatabase/sync": "^0.5.3",
    "@types/d3-shape": "^3.1.8",
    "ai": "^6.0.172",
    "better-auth": "^1.6.9",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "import-in-the-middle": "^3.0.1",
    "layerchart": "2.0.0-next.48",
    "libphonenumber-js": "^1.12.42",
    "lru-cache": "^11.3.5",
    "marked": "^18.0.2",
    "maska": "^3.2.0",
    "mastra": "^1.7.2",
    "mode-watcher": "^1.1.0",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.0.1",
    "replicate": "^1.4.0",
    "runed": "^0.37.1",
    "sharp": "^0.34.5",
    "simple-icons": "^16.18.0",
    "svelte-sonner": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1"
  }
}
