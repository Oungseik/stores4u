{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "daemon": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".svelte-kit/"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    }
  },
  "globalEnv": [
    "TURSO_ORGANIZATION",
    "TURSO_API_TOKEN",
    "AUTH_DATABASE_URL",
    "PARENT_DATABASE_URL",
    "TURSO_PARENT_DB_NAME",
    "TURSO_GROUP_AUTH_TOKEN",
    "TURSO_GROUP",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SES_SMTP_HOST",
    "SES_SMTP_PORT",
    "SES_SMTP_USER",
    "SES_SMTP_PASS",
    "NO_REPLY_EMAIL",
    "BETTER_AUTH_URL",
    "PUBLIC_ENVIRONMENT",
    "BETTER_AUTH_SECRET",
    "PUBLIC_SITE_NAME",
    "SHOP_DATA_DIR",
    "MIGRATION_FOLDER",
    "SHOP_SLUG",
    "STORAGE_PUBLIC_URL",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_BUCKET_NAME",
    "STORAGE_ENDPOINT",
    "STORAGE_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "S3_SESSION_TOKEN",
    "REPLICATE_API_TOKEN"
  ]
}
