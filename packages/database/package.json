{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/database",
  "description": "Single-store Drizzle schema, SQLite client factory, and Drizzle Kit config",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "check": "biome check --write .",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "db:push": "bun --bun run with-env drizzle-kit push",
    "db:generate": "bun --bun run with-env drizzle-kit generate",
    "db:migrate": "bun --bun run with-env drizzle-kit migrate",
    "db:studio": "bun --bun run with-env drizzle-kit studio"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3"
  }
}
