{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "daemon": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    }
  },
  "globalEnv": [
    "FACEBOOK_CLIENT_ID",
    "FACEBOOK_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SES_SMTP_HOST",
    "SES_SMTP_PORT",
    "SES_SMTP_USER",
    "SES_SMTP_PASS",
    "NO_REPLY_EMAIL",
    "BETTER_AUTH_URL",
    "PUBLIC_ENVIRONMENT",
    "PORT",
    "BETTER_AUTH_SECRET",
    "DATABASE_PATH",
    "PUBLIC_SITE_NAME",
    "STORAGE_PUBLIC_URL",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_BUCKET_NAME",
    "STORAGE_ENDPOINT",
    "STORAGE_SECRET_ACCESS_KEY",
    "MISTRAL_API_KEY",
    "ORIGIN",
    "PUBLIC_DOMAIN"
  ]
}
