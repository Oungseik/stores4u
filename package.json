{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "svelte_kit_starter",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo $@ dev",
    "preview": "turbo $@ preview",
    "build": "turbo $@ build",
    "typecheck": "turbo $@ typecheck",
    "lint": "turbo $@ lint",
    "format": "turbo $@ format",
    "check": "turbo $@ typecheck lint format",
    "test": "bun run test:website && bun run test:database",
    "test:website": "cd apps/website && bun run test",
    "test:database": "cd packages/database && bun run test",
    "shadcn-extras": "pnpm dlx jsrepo add --cwd packages/ui",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c packages/ui",
    "db:studio": "turbo db:studio",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "deploy": "bun scripts/deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "turbo": "^2.10.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.2.8",
  "resolutions": {
    "@tanstack/query-core": "5.96.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4"
  }
}
