{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/config",
  "description": "Domain logic enums and variables to share between different packages",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run format"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/**/*.ts",
      "default": "./src/**/*.ts"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "tsdown": "0.22.9",
    "typescript": "^7.0.2"
  }
}
